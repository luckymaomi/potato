{
  "name": "tomato-ai-drama-backend",
  "version": "0.0.1",
  "description": "TypeScript backend for tomato-ai-drama",
  "main": "dist/server.js",
  "scripts": {
    "start": "tsx src/server.ts",
    "start:dist": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "init:rainy-night-demo": "tsx scripts/initializeRainyNightDemo.ts",
    "accept:rainy-night-demo": "tsx scripts/initializeRainyNightDemo.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:providers": "node --import tsx --test test/agnesProvider.test.ts test/pearApiProvider.test.ts test/providerRegistry.test.ts test/providerRuntime.test.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "4.22.3",
    "js-yaml": "5.4.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "0.35.4",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.2",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
